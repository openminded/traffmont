<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. COMPACT PILL MODE (Default Draggable Pill) -->
    <LinearLayout
        android:id="@+id/floating_collapsed_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="visible">

        <!-- Status Dot -->
        <View
            android:id="@+id/float_pill_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_server_badge" />

        <!-- Interface Name -->
        <TextView
            android:id="@+id/float_pill_iface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="[SERVER] ether1"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Download Speed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬇"
            android:textColor="@color/rx_download"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/float_pill_rx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:text="0.0 M"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Upload Speed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬆"
            android:textColor="@color/tx_upload"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/float_pill_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:text="0.0 M"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Latency -->
        <TextView
            android:id="@+id/float_pill_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14ms"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- 2. EXPANDED DETAIL CARD (When Tapped, Matches Sparkline Graph Screenshot) -->
    <LinearLayout
        android:id="@+id/floating_expanded_view"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Top Header & Actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title & Status Dot -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/float_actions_layout"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/float_exp_status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_server_badge" />

                <TextView
                    android:id="@+id/float_exp_router_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Indosat Rackh - Sungai Paku"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Window Action Buttons (Lock, Settings, Minimize, Close) -->
            <LinearLayout
                android:id="@+id/float_actions_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/float_btn_lock"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="3dp"
                    android:src="@drawable/ic_lock_open" />

                <ImageView
                    android:id="@+id/float_btn_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="3dp"
                    android:src="@drawable/ic_settings" />

                <ImageView
                    android:id="@+id/float_btn_minimize"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="3dp"
                    android:src="@drawable/ic_minimize" />

                <ImageView
                    android:id="@+id/float_btn_close"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="3dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Speed Details: RX (Download) & TX (Upload) with Peaks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- RX (Download) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ RX (DOWNLOAD)"
                    android:textColor="#38BDF8"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/float_exp_rx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0.00 bps"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/float_exp_rx_peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Peak: 0.00 bps"
                    android:textColor="@color/text_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- TX (Upload) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ TX (UPLOAD)"
                    android:textColor="#C084FC"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/float_exp_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0.00 bps"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/float_exp_tx_peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Peak: 0.00 bps"
                    android:textColor="@color/text_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Real-time Sparkline Graph -->
        <com.traffmont.widget.TrafficGraphView
            android:id="@+id/float_graph_view"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp" />

        <!-- Footer Row -->
        <TextView
            android:id="@+id/float_exp_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Connected to Indosat Rackh - Sungai Paku"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp" />

    </LinearLayout>

</FrameLayout>
